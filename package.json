{
  "name": "@kep4yk/rbac-jwt-core",
  "version": "1.0.0",
  "description": "JWT-based access control (RBAC) system core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "tsc",
    "prepare": "husky"
  },
  "keywords": [
    "rbac",
    "jwt",
    "authorization",
    "access-control"
  ],
  "author": "Daniil-Ivanuk",
  "license": "AGPL-3.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.2",
    "redis": "^6.2.1"
  },
  "lint-staged": {
  "src/**/*.ts": [
    "prettier --write"
  ],
  "tests/**/*.ts": [
    "prettier --write"
  ]
}
}
